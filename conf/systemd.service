[Unit]
Description=YunoHost MCP: Nostr-authenticated MCP server for YunoHost administration
After=network.target yunohost_mcp-helper.service
Requires=yunohost_mcp-helper.service

[Service]
Type=simple
User=__APP__
Group=__APP__

# The network-facing process is deliberately unprivileged. Root-only
# YunoHost operations are delegated to the local typed broker below.
WorkingDirectory=__INSTALL_DIR__/
Environment=PATH=__INSTALL_DIR__/venv/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=YUNOHOST_MCP_CONFIG_DIR=__DATA_DIR__
Environment=YUNOHOST_MCP_FAKE_YUNOHOST=false
Environment=YUNOHOST_MCP_BROKER_SOCKET_PATH=/run/yunohost_mcp/broker.sock
Environment=YUNOHOST_MCP_CONFIRMATION_STORE_FILE=__DATA_DIR__/confirmations.sqlite
# Package install/backup/restore test cycles are intentionally synchronous
# and can exceed the ordinary request window on a real server.
Environment=YUNOHOST_MCP_REQUEST_TIMEOUT_SECONDS=1800
# Optional migration backend: when YUNOHOST_MCP_IDENTITY_BACKEND is changed
# to yunohost_groups, the MCP frontend and root broker query this separate
# nostr_auth-owned socket. The default remains TOML until the lookup service
# and group membership have been verified on this host.
Environment=YUNOHOST_MCP_NOSTR_AUTH_LOOKUP_SOCKET=/run/nostr_auth-lookup/lookup.sock
# _catalog_relays()'s optional fourth fallback: widen a catalog search
# with the *calling* identity's own NIP-65 relays, via nostr_auth's
# separate relay-lookup socket (its own RuntimeDirectory, not shared with
# the identity-lookup socket above - see nostr_auth_ynh's
# nostr_auth-relay-lookup.service). Best-effort and silently a no-op if
# nostr_auth's relay-lookup service isn't installed or the caller isn't
# linked - unlike YUNOHOST_MCP_NOSTR_AUTH_LOOKUP_SOCKET above, this has no
# identity-backend gate: it only ever widens an already-authorized call,
# never decides who's authorized.
Environment=YUNOHOST_MCP_NOSTR_AUTH_RELAY_LOOKUP_SOCKET=/run/nostr_auth-relay-lookup/relays.sock
EnvironmentFile=-__DATA_DIR__/identity-backend.env
# Optional Polypack integration. The package refreshes this file from
# Polypack's YunoHost-allocated port during install, upgrade, restore, or an
# explicit config-panel refresh. It is intentionally loopback-only.
EnvironmentFile=-__DATA_DIR__/polypack.env
# Owner co-signing (v0.5.0+, upstream owner-approval-plan.md's `solo`
# profile): pinned explicitly to the install-time admin_npub, rather than
# left to fall back on "whichever single identity.toml entry holds the
# administrator role" - granting a second administrator later (doc/ADMIN.md,
# the config panel's "Grant a new identity") must not silently make owner
# resolution ambiguous and lock out approve_operation.
Environment=YUNOHOST_MCP_OWNER_NPUB=__ADMIN_NPUB__
ExecStart=__INSTALL_DIR__/venv/bin/yunohost-mcp --transport http --host 127.0.0.1 --port __PORT__
Restart=always
RestartSec=5

# Conservative sandboxing for the network-facing process.
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @swap
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target
