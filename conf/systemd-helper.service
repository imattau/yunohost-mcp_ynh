[Unit]
Description=YunoHost MCP privileged operation broker
After=network.target
Before=yunohost_mcp.service

[Service]
Type=simple
User=root
# Keep root's primary GID: YunoHost's LDAP SASL-EXTERNAL root identity is
# gidNumber=0+uidNumber=0. The broker changes only the socket group to
# __APP__ after binding, so the unprivileged frontend can connect.
Group=root
WorkingDirectory=__INSTALL_DIR__/
Environment=PATH=__INSTALL_DIR__/venv/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=YUNOHOST_MCP_CONFIG_DIR=__DATA_DIR__
Environment=YUNOHOST_MCP_FAKE_YUNOHOST=false
Environment=YUNOHOST_MCP_CONFIRMATION_STORE_FILE=__DATA_DIR__/confirmations.sqlite
# The root broker independently resolves the caller through nostr_auth; it
# must use the same private lookup socket as the unprivileged frontend.
Environment=YUNOHOST_MCP_NOSTR_AUTH_LOOKUP_SOCKET=/run/nostr_auth-lookup/lookup.sock
# catalog_list()/catalog_publish() etc. always run here (the broker), not
# the frontend, whenever one is configured - same reasoning and same
# separate socket as conf/systemd.service's identical line.
Environment=YUNOHOST_MCP_NOSTR_AUTH_RELAY_LOOKUP_SOCKET=/run/nostr_auth-relay-lookup/relays.sock
EnvironmentFile=-__DATA_DIR__/identity-backend.env
ExecStart=__INSTALL_DIR__/venv/bin/yunohost-mcp-broker --socket-path=/run/yunohost_mcp/broker.sock --allowed-user=__APP__
Restart=always
RestartSec=5
# 0755, not something narrower: systemd's RuntimeDirectory= is (re)created
# on every start owned by this unit's own User=/Group= (root:root, per the
# comment above) - an ExecStartPre chown to __APP__'s group does NOT stick,
# confirmed live: it reports success but the directory's group is still
# root afterwards, silently blocking the frontend (group __APP__, not
# root) from even traversing into /run/yunohost_mcp to reach the socket,
# regardless of the socket file's own correct permissions. Real access
# control is the socket file's own 0660 root:__APP__ ownership (broker's
# main(), which explicitly os.chown()s it after binding) - same reasoning
# already applied to nostr_auth-identity-lookup.service's identical fix.
RuntimeDirectory=yunohost_mcp
RuntimeDirectoryMode=0755
PrivateTmp=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @swap
ReadWritePaths=__DATA_DIR__ /run/yunohost_mcp

[Install]
WantedBy=multi-user.target
