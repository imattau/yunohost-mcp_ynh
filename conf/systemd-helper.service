[Unit]
Description=YunoHost MCP privileged operation broker
After=network.target
Before=yunohost_mcp.service

[Service]
Type=simple
User=root
# Keep root's primary GID: YunoHost's LDAP SASL-EXTERNAL root identity is
# gidNumber=0+uidNumber=0. The broker changes only the socket group to
# __APP__ after binding, so the unprivileged frontend can connect.
Group=root
WorkingDirectory=__INSTALL_DIR__/
Environment=PATH=__INSTALL_DIR__/venv/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=YUNOHOST_MCP_CONFIG_DIR=__DATA_DIR__
Environment=YUNOHOST_MCP_FAKE_YUNOHOST=false
Environment=YUNOHOST_MCP_CONFIRMATION_STORE_FILE=__DATA_DIR__/confirmations.sqlite
# The root broker independently resolves the caller through nostr_auth; it
# must use the same private lookup socket as the unprivileged frontend.
Environment=YUNOHOST_MCP_NOSTR_AUTH_LOOKUP_SOCKET=/run/nostr_auth-lookup/lookup.sock
EnvironmentFile=-__DATA_DIR__/identity-backend.env
ExecStart=__INSTALL_DIR__/venv/bin/yunohost-mcp-broker --socket-path=/run/yunohost_mcp/broker.sock --allowed-user=__APP__
Restart=always
RestartSec=5
RuntimeDirectory=yunohost_mcp
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/install -d -o root -g __APP__ -m 0750 /run/yunohost_mcp
PrivateTmp=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @swap
ReadWritePaths=__DATA_DIR__ /run/yunohost_mcp

[Install]
WantedBy=multi-user.target
