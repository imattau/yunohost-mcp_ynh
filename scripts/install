#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

#=================================================
# INSTALL PYTHON VIRTUAL ENVIRONMENT
#=================================================
ynh_script_progression "Setting up the Python virtual environment..."

yunohost_mcp_install_venv

#=================================================
# PERSISTENT DATA DIRECTORY
#=================================================
ynh_script_progression "Setting up persistent data directory..."

# identity.toml, policy.toml, audit.jsonl, the server's own Nostr keypair,
# and revoked_delegations.toml all live under $data_dir - some
# admin-authored, some generated by the app itself at runtime - so all of
# it survives upgrades and reinstalls. See YUNOHOST_MCP_CONFIG_DIR in
# conf/systemd.service.
yunohost_mcp_seed_identity "$admin_npub"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="YunoHost MCP server (Nostr-authenticated)"

#=================================================
# START APP
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" \
	--log_path="systemd" \
	--wait_until="Uvicorn running on"

#=================================================
# END OF SCRIPT
#=================================================
yunohost_mcp_print_connection_info "$domain"

ynh_script_progression "Installation of $app completed"
ynh_script_progression "Your npub ($admin_npub) is already granted administrator - see doc/ADMIN.md to add more identities"
