#!/bin/bash
#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

ynh_abort_if_errors

#=================================================
# RETRIEVE ARGUMENTS
#=================================================

install_dir=$(ynh_app_setting_get --key=install_dir)
data_dir=$(ynh_app_setting_get --key=data_dir)
domain=$(ynh_app_setting_get --key=domain)
path=$(ynh_app_setting_get --key=path)
admin_npub=$(ynh_app_setting_get --key=admin_npub)

get__identity_backend() {
	if [ -f "$data_dir/identity-backend.env" ]; then
		sed -n 's/^YUNOHOST_MCP_IDENTITY_BACKEND=//p' "$data_dir/identity-backend.env"
	else
		echo toml
	fi
}

get__polypack_status() {
	local port env_file configured_url
	env_file="$(yunohost_mcp_polypack_env_file)"
	port="$(yunohost_mcp_polypack_port || true)"
	configured_url="$(sed -n 's/^YUNOHOST_MCP_POLYPACK_URL=//p' "$env_file" 2>/dev/null || true)"
	if [ -n "$port" ]; then
		cat <<EOF
ask:
  en: "Detected Polypack MCP endpoint: http://127.0.0.1:$port/mcp/ (configured: ${configured_url:-not yet})"
  fr: "Point de terminaison MCP Polypack détecté : http://127.0.0.1:$port/mcp/ (configuré : ${configured_url:-pas encore})"
EOF
	else
		cat <<'EOF'
ask:
  en: "Polypack MCP is not installed/configured. The integration is optional."
  fr: "Polypack MCP n'est pas installé/configuré. L'intégration est facultative."
EOF
	fi
}

set__identity_backend() {
	if [ "$identity_backend" = "yunohost_groups" ] && ! getent group nostr-auth-lookup >/dev/null; then
		ynh_die "nostr-auth-lookup group is not available; install or upgrade nostr_auth before enabling group authorization"
	fi
	if [ "$identity_backend" = "yunohost_groups" ] && ! id -nG "$app" | tr ' ' '\n' | grep -qx nostr-auth-lookup; then
		ynh_die "$app is not a member of nostr-auth-lookup; reinstall or upgrade both packages before enabling group authorization"
	fi
	yunohost_mcp_set_identity_backend "$identity_backend"
	systemctl restart "$app-helper.service"
	ynh_systemctl --service="$app" --action="restart" --log_path="systemd" --wait_until="Uvicorn running on"
	ynh_print_info "Identity backend changed to $identity_backend"
}

#=================================================
# SHARED PYTHON HELPER
#=================================================

# All identity.toml / revoked_delegations.toml reads and writes go through
# this one script, run inside the app's own venv (so it can reuse
# yunohost_mcp's own npub/role validation rather than re-implementing it in
# bash) - user-supplied values (npub, name, role, expires, revoked ids) are
# always passed as argv, never interpolated into the python source itself.
_ymcp_identity_tool() {
	"$install_dir/venv/bin/python3" - "$@" <<'PYEOF'
import json
import sys
import tomllib
from pathlib import Path


def _load(path: Path) -> dict:
    if not path.exists():
        return {}
    return tomllib.loads(path.read_text()).get("identity", {})


def _serialize(identities: dict) -> str:
    parts = []
    for key, entry in identities.items():
        parts.append(f'[identity."{key}"]')
        parts.append(f"name = {json.dumps(entry.get('name', key))}")
        roles = ", ".join(json.dumps(r) for r in entry.get("roles", []))
        parts.append(f"roles = [{roles}]")
        if entry.get("expires"):
            parts.append(f"expires = {json.dumps(entry['expires'])}")
        parts.append("")
    return "\n".join(parts)


def cmd_summary(identity_path: str) -> None:
    identities = _load(Path(identity_path))
    if not identities:
        print("(no identities granted - this should not happen after a normal install)")
        return
    lines = []
    for key, entry in identities.items():
        roles = ", ".join(entry.get("roles", []))
        expires = entry.get("expires") or "never"
        short = key if len(key) <= 20 else key[:16] + "…"
        lines.append(f"- {entry.get('name', key)} ({short}): {roles}, expires {expires}")
    print("\n".join(lines))


def cmd_choices(identity_path: str) -> None:
    """YAML `choices:` mapping (npub -> a human-readable label) for the
    edit/revoke panels' select fields, so an admin picks an identity from
    a dropdown instead of having to remember/copy-paste its exact npub -
    see get__edit_npub/get__revoke_npub below. Deliberately not the
    `ask:`-only override pattern cmd_summary's caller (get__identities_summary)
    uses: choices is itself a real, documented override key a getter's
    YAML output can set on a select option (see YunoHost core's
    configpanel.py _get_partial_raw_settings_and_mutate_config, which
    setattr()s any non-value/current_value key from a getter's dict
    output directly onto the option object)."""
    identities = _load(Path(identity_path))
    print("choices:")
    if not identities:
        print('  placeholder: "(no identities currently granted)"')
        return
    for key, entry in identities.items():
        name = entry.get("name", key)
        roles = ", ".join(entry.get("roles", [])) or "no roles"
        short = key if len(key) <= 20 else key[:16] + "…"
        label = f"{name} ({roles}) — {short}"
        print(f"  {json.dumps(key)}: {json.dumps(label)}")


def cmd_grant(identity_path: str, npub: str, name: str, role: str, expires: str) -> None:
    from yunohost_mcp.auth.npub import Bech32Error, npub_to_hex
    from yunohost_mcp.policy.roles import ROLE_SCOPES

    if role not in ROLE_SCOPES:
        sys.exit(f"unknown role: {role!r}; known roles: {sorted(ROLE_SCOPES)}")
    try:
        npub_to_hex(npub)
    except Bech32Error as exc:
        sys.exit(f"invalid npub: {exc}")

    path = Path(identity_path)
    identities = _load(path)
    if npub in identities:
        sys.exit(f"{npub} is already granted - use Edit an existing identity instead to change its role, name, or expiry")

    block = f'\n[identity."{npub}"]\nname = {json.dumps(name or npub)}\nroles = [{json.dumps(role)}]\n'
    if expires:
        block += f'expires = {json.dumps(expires + "T00:00:00+00:00")}\n'
    with path.open("a") as f:
        f.write(block)
    print(f"granted {role} to {npub}")


def cmd_edit(identity_path: str, npub: str, name: str, role: str, expires: str) -> None:
    from yunohost_mcp.auth.npub import Bech32Error, npub_to_hex
    from yunohost_mcp.policy.roles import ROLE_SCOPES

    try:
        npub_to_hex(npub)
    except Bech32Error as exc:
        sys.exit(f"invalid npub: {exc}")

    path = Path(identity_path)
    identities = _load(path)
    if npub not in identities:
        sys.exit(f"{npub} is not currently granted - use Grant a new identity instead")

    entry = dict(identities[npub])
    current_roles = entry.get("roles", [])

    if role:
        if role not in ROLE_SCOPES:
            sys.exit(f"unknown role: {role!r}; known roles: {sorted(ROLE_SCOPES)}")
        if "administrator" in current_roles and role != "administrator":
            others = {k: v for k, v in identities.items() if k != npub}
            remaining_admins = [k for k, v in others.items() if "administrator" in v.get("roles", [])]
            if not remaining_admins:
                sys.exit(
                    "refusing to demote the last administrator identity - this would lock every "
                    "agent out of privileged access; edit identity.toml directly over SSH if this "
                    "is genuinely intended (see doc/ADMIN.md)"
                )
        entry["roles"] = [role]

    if name:
        entry["name"] = name

    if expires == "clear":
        entry.pop("expires", None)
    elif expires:
        entry["expires"] = expires + "T00:00:00+00:00"

    identities[npub] = entry
    path.write_text(_serialize(identities))
    print(f"updated {npub}")


def cmd_revoke(identity_path: str, npub: str) -> None:
    path = Path(identity_path)
    identities = _load(path)
    if npub not in identities:
        sys.exit(f"{npub} is not currently granted")

    removed_was_admin = "administrator" in identities[npub].get("roles", [])
    remaining = {k: v for k, v in identities.items() if k != npub}
    remaining_admins = [k for k, v in remaining.items() if "administrator" in v.get("roles", [])]
    if removed_was_admin and not remaining_admins:
        sys.exit(
            "refusing to remove the last administrator identity - this would lock every agent "
            "out of privileged access; edit identity.toml directly over SSH if this is genuinely "
            "intended (see doc/ADMIN.md)"
        )

    path.write_text(_serialize(remaining))
    print(f"revoked {npub}")


def cmd_list_revoked(revoked_path: str) -> None:
    path = Path(revoked_path)
    if not path.exists():
        return
    data = tomllib.loads(path.read_text())
    print(",".join(data.get("revoked", [])))


def cmd_set_revoked(revoked_path: str, ids_csv: str) -> None:
    ids = sorted({i for i in ids_csv.split(",") if i})
    items = ", ".join(json.dumps(i) for i in ids)
    Path(revoked_path).write_text(f"revoked = [{items}]\n")
    print(f"{len(ids)} delegation(s) revoked")


COMMANDS = {
    "summary": cmd_summary,
    "choices": cmd_choices,
    "grant": cmd_grant,
    "edit": cmd_edit,
    "revoke": cmd_revoke,
    "list-revoked": cmd_list_revoked,
    "set-revoked": cmd_set_revoked,
}

_cmd, *_args = sys.argv[1:]
COMMANDS[_cmd](*_args)
PYEOF
}

# identity.toml / revoked_delegations.toml are owned by $app, mode 640
# (yunohost_mcp_seed_identity in _common.sh) - restore that after any
# rewrite from these root-run config scripts, the same as install does.
_ymcp_fix_perms() {
	chown "$app:$app" "$1"
	chmod 640 "$1"
}

# Same NIP-46 pairing session (and pending offer) install's optional
# pair_owner_signer_now step creates (_common.sh's
# yunohost_mcp_approve_session_file/yunohost_mcp_approve_offer_file) - the
# config panel's Pair/Approve actions below reuse them rather than each
# pairing separately.
_ymcp_approve_bin() {
	"$install_dir/venv/bin/yunohost-mcp-approve" \
		--session-file "$(yunohost_mcp_approve_session_file)" \
		--offer-file "$(yunohost_mcp_approve_offer_file)" \
		"$@"
}

# The offer/session files are created root-owned (every config script here
# runs as root) - match identity.toml's app:app ownership so they behave
# consistently under backup/restore and aren't just a root-only artifact.
_ymcp_fix_approve_file_perms() {
	for f in "$(yunohost_mcp_approve_session_file)" "$(yunohost_mcp_approve_offer_file)"; do
		[ -e "$f" ] || continue
		chown "$app:$app" "$f"
		chmod 600 "$f"
	done
}


#=================================================
# GETTERS
#=================================================

get__identities_summary() {
	local summary backend
	backend="$(get__identity_backend)"
	if [ "$backend" = "yunohost_groups" ]; then
		cat <<'EOF'
ask:
  en: |
    Nostr identities are resolved by nostr_auth and authorised through YunoHost MCP role groups. See YunoHost group access below for the current assignments.
  fr: |
    Les identités Nostr sont résolues par nostr_auth et autorisées par les groupes de rôles MCP YunoHost. Consultez l'accès par groupes YunoHost ci-dessous pour voir les attributions actuelles.
EOF
		return
	fi
	summary="$(_ymcp_identity_tool summary "$data_dir/identity.toml")"
	cat <<EOF
ask:
  en: |
$(echo "$summary" | sed 's/^/    /')
EOF
}

get__revoked_delegation_ids() {
	_ymcp_identity_tool list-revoked "$data_dir/revoked_delegations.toml"
}

get__edit_npub() {
	_ymcp_identity_tool choices "$data_dir/identity.toml"
}

get__revoke_npub() {
	_ymcp_identity_tool choices "$data_dir/identity.toml"
}

get__group_user() {
	# Use NSS directly rather than `yunohost user list`: group-backed
	# authorization already depends on NSS, and this avoids invoking
	# Moulinette's authenticated LDAP API merely to populate a dropdown.
	# YunoHost user accounts use uid >= 1000; app/system service accounts do
	# not appear in this selector. The GECOS field normally contains the
	# user's full name.
	local users
	users="$(getent passwd 2>/dev/null | /usr/bin/python3 -c '
import json
import sys

choices = {}
for line in sys.stdin:
    fields = line.rstrip("\\n").split(":", 6)
    if len(fields) != 7:
        continue
    username, gecos = fields[0], fields[4]
    try:
        uid = int(fields[2])
    except ValueError:
        continue
    if uid < 1000 or username in {"root", "nobody"}:
        continue
    fullname = gecos.split(",", 1)[0].strip()
    choices[username] = f"{fullname} ({username})" if fullname else username
print("choices:")
if not choices:
    print("  placeholder: \\\"(no YunoHost users found)\\\"")
else:
    for username in sorted(choices):
        print(f"  {json.dumps(username)}: {json.dumps(choices[username])}")
')"
	if [ -z "$users" ]; then
		printf 'choices:\n  placeholder: "(could not load YunoHost users from NSS)"\n'
		return
	fi
	printf '%s\n' "$users"
}

get__group_assignments() {
	local group members summary=""
	for group in \
		yunohost-mcp-readonly \
		yunohost-mcp-operator \
		yunohost-mcp-app-admin \
		yunohost-mcp-package-developer \
		yunohost-mcp-administrator; do
		members="$(getent group "$group" | cut -d: -f4)"
		[ -n "$members" ] || members="(none)"
		summary="$summary\n- $group: $members"
	done
	cat <<EOF
ask:
  en: |
$(printf '%b\n' "$summary" | sed 's/^/    /')
EOF
}

get__pairing_status() {
	local status
	status="$(_ymcp_approve_bin status 2>&1)"
	local summary
	if echo "$status" | grep -q "^paired: true"; then
		local signer_pubkey
		signer_pubkey="$(echo "$status" | sed -n 's/^signer_pubkey: //p')"
		summary="Paired with signer $signer_pubkey. Use Approve a pending operation below when an agent gives you a confirmation_id, or Pair or re-pair your signer to switch signer apps."
	else
		# offer (not pair) - persists a stable link/QR without waiting on
		# anything, so it's shown here directly rather than only ever
		# appearing inside the Pair action's own scrolling operation log.
		# Idempotent: same link on every panel load until it expires,
		# someone actually pairs, or Pair is clicked with different relays.
		local offer_output
		offer_output="$(_ymcp_approve_bin offer --owner-npub "$admin_npub" 2>/dev/null)"
		_ymcp_fix_approve_file_perms
		local offer_uri
		offer_uri="$(echo "$offer_output" | head -n1)"
		local qr
		qr="$(echo "$offer_output" | tail -n +2)"

		if [ -n "$offer_uri" ]; then
			# Fenced as a code block, not plain text: the ASCII QR is built
			# from Unicode block-drawing characters that only stay compact
			# and square in a monospace font at a small, fixed size - as
			# plain paragraph text (proportional font, ambient size) it
			# renders enormous. The webadmin's markdown renderer turns a
			# ``` fence into a <pre><code> block, which fixes both.
			summary="Not paired yet. Scan this in your NIP-46 signer app (Amber, nsec.app, ...), then click Pair or re-pair your signer below to complete pairing - this exact code stays valid across page reloads:

\`\`\`
$offer_uri
\`\`\`"
			# Raw HTML, not a ``` fence, specifically for the QR: an
			# inline font-size is the only remaining lever against this
			# rendering unreasonably large (a fenced code block's font
			# size isn't ours to set). Self-diagnosing either way - if
			# the webadmin's markdown renderer doesn't pass raw HTML
			# through, this will show up as literal "<pre style=...>"
			# text instead of doing anything, which tells us definitively
			# to stop pursuing this angle rather than guess further.
			[ -n "$qr" ] && summary="$summary
<pre style=\"font-size:5px;line-height:1;\">
$qr
</pre>"
		else
			summary="Not paired yet, and could not generate a pairing link right now - click Pair or re-pair your signer below and check its output for details."
		fi
	fi
	cat <<EOF
ask:
  en: |
$(echo "$summary" | sed 's/^/    /')
EOF
}

#=================================================
# SETTERS
#=================================================

run__do_group_assign() {
	[ "$(get__identity_backend)" = "yunohost_groups" ] || \
		ynh_die "Switch the authorization backend to yunohost_groups before assigning group roles"
	[ -n "${group_user:-}" ] || ynh_die "Select a YunoHost user"
	[ -n "${group_role:-}" ] || ynh_die "Select an MCP role"
	case "$group_role" in
		readonly|operator|app-admin|package-developer|administrator) ;;
		*) ynh_die "Unknown MCP role: $group_role" ;;
	esac
	yunohost user info "$group_user" >/dev/null 2>&1 || ynh_die "Unknown YunoHost user: $group_user"

	local group selected_group="yunohost-mcp-$group_role"
	for group in \
		yunohost-mcp-readonly \
		yunohost-mcp-operator \
		yunohost-mcp-app-admin \
		yunohost-mcp-package-developer \
		yunohost-mcp-administrator; do
		# Removing a user who is not a member is harmless but some YunoHost
		# versions return non-zero; keep the operation idempotent.
		yunohost user group update "$group" --remove "$group_user" >/dev/null 2>&1 || true
	done
	yunohost user group update "$selected_group" --add "$group_user" \
		|| ynh_die "Could not assign $group_role to $group_user"
	ynh_print_info "Assigned MCP role $group_role to YunoHost user $group_user"
}

run__do_group_remove() {
	[ "$(get__identity_backend)" = "yunohost_groups" ] || \
		ynh_die "Switch the authorization backend to yunohost_groups before removing group access"
	[ -n "${group_user:-}" ] || ynh_die "Select a YunoHost user"
	yunohost user info "$group_user" >/dev/null 2>&1 || ynh_die "Unknown YunoHost user: $group_user"

	local group
	for group in \
		yunohost-mcp-readonly \
		yunohost-mcp-operator \
		yunohost-mcp-app-admin \
		yunohost-mcp-package-developer \
		yunohost-mcp-administrator; do
		yunohost user group update "$group" --remove "$group_user" >/dev/null 2>&1 || true
	done
	ynh_print_info "Removed MCP group access from YunoHost user $group_user"
}

set__revoked_delegation_ids() {
	_ymcp_identity_tool set-revoked "$data_dir/revoked_delegations.toml" "$revoked_delegation_ids"
	_ymcp_fix_perms "$data_dir/revoked_delegations.toml"
}

#=================================================
# ACTIONS
#=================================================

run__do_grant() {
	[ -n "${grant_npub:-}" ] || ynh_die "Enter the agent's npub before granting access"

	_ymcp_identity_tool grant "$data_dir/identity.toml" "$grant_npub" "${grant_name:-$grant_npub}" \
		"$grant_role" "${grant_expires:-}" || ynh_die "Could not grant access - see the error above"
	_ymcp_fix_perms "$data_dir/identity.toml"
	ynh_print_info "Granted $grant_role to $grant_npub - effective immediately, no restart needed"
}

run__do_edit() {
	[ -n "${edit_npub:-}" ] || ynh_die "Enter the agent's npub to edit"

	local role_arg="${edit_role:-}"
	[ "$role_arg" = "(keep current)" ] && role_arg=""

	_ymcp_identity_tool edit "$data_dir/identity.toml" "$edit_npub" "${edit_name:-}" \
		"$role_arg" "${edit_expires:-}" || ynh_die "Could not edit identity - see the error above"
	_ymcp_fix_perms "$data_dir/identity.toml"
	ynh_print_info "Updated $edit_npub - effective immediately, no restart needed"
}

run__do_revoke() {
	[ -n "${revoke_npub:-}" ] || ynh_die "Enter an npub to revoke"

	_ymcp_identity_tool revoke "$data_dir/identity.toml" "$revoke_npub" \
		|| ynh_die "Could not revoke access - see the error above"
	_ymcp_fix_perms "$data_dir/identity.toml"
	ynh_print_info "Revoked $revoke_npub - effective immediately, no restart needed"
}

run__do_resync_relays() {
	local status
	status="$(_ymcp_approve_bin status 2>&1)"
	if echo "$status" | grep -q "^paired: true"; then
		ynh_print_info "Already paired - nothing to sync. Revoke/re-pair below if you want to change signer or relays."
		return
	fi

	# --regenerate: this button's whole point is retrying the NIP-65
	# lookup even though a cached offer already exists (get__pairing_status
	# above would otherwise just keep reusing it) - a fresh offer/code is
	# an unavoidable side effect of actually re-running discovery, since
	# the old code's relay= params can't be edited in place.
	ynh_print_info "Looking up your relay list again..."
	_ymcp_approve_bin offer --owner-npub "$admin_npub" --regenerate >/dev/null \
		|| ynh_die "Could not refresh the relay list - see the output above"
	_ymcp_fix_approve_file_perms
	ynh_print_info "Done - reload this panel (or scroll up) to see the refreshed code in Signer status."
}

run__do_refresh_polypack() {
	yunohost_mcp_set_polypack_endpoint
	# The EnvironmentFile is read only when the service starts. This action is
	# explicit so simply opening the config panel never restarts MCP.
	ynh_systemctl --service="$app" --action="restart" --log_path="systemd" --wait_until="Uvicorn running on"
	ynh_print_info "YunoHost MCP restarted with the refreshed Polypack endpoint."
}

run__do_pair() {
	# --repair: config panel actions are always deliberate re-runs (there's
	# no separate "first time" UI state to distinguish), so always allow
	# re-pairing rather than dying with "already paired" on a second click -
	# e.g. after switching signer apps or losing the paired device.

	if [ -n "${pair_bunker_uri:-}" ]; then
		# Bypasses the whole offer/QR path entirely - the signer's own
		# exported connection string already fully describes how to reach
		# it, so this connects immediately rather than waiting on anything.
		ynh_print_info "Connecting to the pasted bunker:// signer..."
		_ymcp_approve_bin pair --repair --bunker-uri "$pair_bunker_uri" \
			|| ynh_die "Could not pair with that bunker:// URI - see the output above (check it's current and try again)"
		_ymcp_fix_approve_file_perms
		ynh_print_info "Signer paired - owner-gated operations can now be approved below."
		return
	fi

	# Normally reuses whichever offer get__pairing_status above already
	# generated and displayed - the point of the offer/pair split is that
	# this click completes pairing against the exact code the owner just
	# saw and scanned, not a freshly-generated one.
	#
	# Comma-separated pair_extra_relays are folded in as repeated
	# --extra-relay flags - and, since the already-displayed offer was
	# generated without them, --regenerate is added too so they actually
	# take effect instead of being silently ignored in favor of the cached
	# offer.
	local extra_relay_args=()
	if [ -n "${pair_extra_relays:-}" ]; then
		IFS=',' read -ra _extra <<<"$pair_extra_relays"
		for relay in "${_extra[@]}"; do
			relay="$(echo "$relay" | xargs)"
			[ -n "$relay" ] && extra_relay_args+=(--extra-relay "$relay" --regenerate)
		done
	fi

	ynh_print_info "Open the link/QR below in your NIP-46 signer app within the next couple of minutes..."
	_ymcp_approve_bin pair --repair --owner-npub "$admin_npub" "${extra_relay_args[@]}" \
		|| ynh_die "Pairing did not complete - see the output above (timed out, or was rejected by the signer). The same link/QR shown above is still valid - try again, or click this action again for a fresh one."
	_ymcp_fix_approve_file_perms
	ynh_print_info "Signer paired - owner-gated operations can now be approved below."
}

run__do_approve() {
	[ -n "${approve_confirmation_id:-}" ] || ynh_die "Enter the confirmation_id an agent gave you"

	# --yes: clicking this button *is* the owner's explicit confirmation -
	# yunohost-mcp-approve's own operation_plan/operation_hash output
	# (printed below) is what the owner is expected to have read first,
	# same as the interactive CLI's own "yes" prompt would have shown.
	_ymcp_approve_bin approve --server "https://${domain}${path%/}/mcp" \
		--confirmation-id "$approve_confirmation_id" --yes \
		|| ynh_die "Approval failed - see the output above"
	ynh_print_info "Approved $approve_confirmation_id - the requester can now retry its original call."
}

#=================================================
ynh_app_config_run "$1"
