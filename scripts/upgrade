#!/bin/bash

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"
# The helper shares the virtual environment with the frontend. Stop it before
# replacing the source/venv so no root process can execute code from a mixed
# old/new installation during the upgrade.
systemctl stop "$app-helper.service" >/dev/null 2>&1 || true

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_setup_source --dest_dir="$install_dir" --full_replace

#=================================================
# REINSTALL PYTHON VIRTUAL ENVIRONMENT
#=================================================
# ynh_setup_source --full_replace wipes install_dir, so the venv (which
# lived under it) is gone too - rebuild it from the fresh source.
ynh_script_progression "Setting up the Python virtual environment..."

yunohost_mcp_install_venv

# Preserve the selected backend across upgrades; old installs default to the
# compatibility backend until an administrator explicitly changes it.
if [ ! -f "$data_dir/identity-backend.env" ]; then
	yunohost_mcp_set_identity_backend "toml"
fi
yunohost_mcp_set_polypack_endpoint
yunohost_mcp_prepare_runtime_files
yunohost_mcp_ensure_scope_groups

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

if getent group nostr-auth-lookup >/dev/null; then
	usermod --append --groups nostr-auth-lookup "$app"
fi

ynh_config_add_nginx

ynh_config_add_systemd --service="$app-helper" --template="systemd-helper.service"
ynh_config_add_systemd

yunohost service add "$app" --description="YunoHost MCP server (Nostr-authenticated)"
yunohost service add "$app-helper" --description="YunoHost MCP privileged operation broker"
systemctl enable "$app-helper.service" --quiet
systemctl restart "$app-helper.service"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" \
	--log_path="systemd" \
	--wait_until="Uvicorn running on"

#=================================================
# END OF SCRIPT
#=================================================
yunohost_mcp_print_connection_info "$domain"

ynh_script_progression "Upgrade of $app completed"
